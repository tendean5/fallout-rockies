config_version=5

[application]

config/name="Fallout Rockies"
config/tags=PackedStringArray()
config/description="A Colorado-specific, Fallout-inspired overworld — roguelike die-and-return."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Audio="*res://scripts/audio.gd"
Game="*res://scripts/game.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/viewport_width=320
window/size/viewport_height=176
window/size/override_default_width=true
window/size/override_default_height=true
window/size/width=960
window/size/height=528
window/size/resizable=true
window/size/maximize=false

[rendering]

antialiasing/edge/enable=false
